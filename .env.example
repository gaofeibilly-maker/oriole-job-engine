# Optional. Leave blank to run with the official catalog and keyless Common Crawl discovery.
HUANGQUE_BAIDU_API_KEY=

# The endpoint is locked in code to Baidu's official qianfan.baidubce.com host.
HUANGQUE_BAIDU_ENDPOINT=https://qianfan.baidubce.com/v2/ai_search/web_search
HUANGQUE_BAIDU_DAILY_BUDGET=40

# Optional persistent paths. Relative paths are resolved from the process working directory.
HUANGQUE_REGISTRY_PATH=.huangque/state.json
HUANGQUE_ARTIFACT_ROOT=.huangque/artifacts
HUANGQUE_EMPLOYER_UNIVERSE_PATH=data/huangque/employer-universe.json
HUANGQUE_SOURCE_SPIDER_STATE_PATH=.huangque/source-spider-state.json

# Independent updater/spider limits.
HUANGQUE_DAILY_MAX_COLLECTIONS=100
HUANGQUE_SOURCE_SPIDER_MAX_EMPLOYERS=100
HUANGQUE_SOURCE_SPIDER_MAX_PROBES=20
HUANGQUE_SOURCE_SPIDER_MAX_CRAWL_PAGES=20
HUANGQUE_DEEP_SCAN_MAX_QUERIES=150
HUANGQUE_DEEP_SCAN_MAX_PROBES=20

# MCP safety limits.
HUANGQUE_MCP_TOOL_DEADLINE_MS=60000
HUANGQUE_MCP_CALLS_PER_MINUTE=60
HUANGQUE_MCP_NETWORK_CALLS_PER_MINUTE=20
HUANGQUE_MCP_MAX_CONCURRENT=4
HUANGQUE_MCP_MAX_NETWORK_CONCURRENT=2
HUANGQUE_MCP_OUTBOUND_REQUESTS_PER_MINUTE=300
HUANGQUE_MCP_DISCOVERY_REQUESTS_PER_TOOL=100
HUANGQUE_MCP_PROBE_REQUESTS_PER_TOOL=80
HUANGQUE_MCP_COLLECTION_REQUESTS_PER_TOOL=100
HUANGQUE_MCP_MAX_OUTPUT_BYTES=4000000

# Keep disabled unless the MCP operator intentionally delegates source approval.
HUANGQUE_ALLOW_MCP_REVIEW=0
